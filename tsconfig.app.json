{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "composite": true,
    "outDir": "./dist"
  },
  "include": ["frontend/**/*"],
  "exclude": ["node_modules", "src"]
}
