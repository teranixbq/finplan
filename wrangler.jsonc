{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finplan",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/login", "/unauthorized"]
  },
  "routes": [
    {
      "pattern": "finplan.apicode.my.id",
      "zone_name": "apicode.my.id",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finplan",
      "database_id": "6d744fba-5b9c-41a1-902c-af36b4f4d163",
      "migrations_dir": "migrations"
    }
  ]
}
